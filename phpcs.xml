<?xml version="1.0"?>
<ruleset name="marksimple">
 <description>Rules for my MarkSimple PHP projects</description>

 <file>./src</file>

 <!-- Code Reviews Rules -->
 <rule ref="Inpsyde">
    <exclude name="WordPress.PHP.POSIXFunctions"/>
    <exclude name="WordPressVIPMinimum.Functions.DynamicCalls"/>
 </rule>
 <rule ref="WordPress.Security.EscapeOutput">
    <severity>0</severity>
 </rule>
</ruleset>
